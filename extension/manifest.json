{
  "manifest_version": 3,
  "name": "VIEWPORT BREAK",
  "version": "1.4.1",
  "description": "Chrome ウィンドウ自体を 375/390px などのレスポンシブ確認幅へ即座に切り替える。500px の下限を native host 経由で貫通する。",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging"
  ],
  "action": {
    "default_title": "VIEWPORT BREAK — ウィンドウ幅を切り替える",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "width-360": {
      "description": "幅 360px にする"
    },
    "width-375": {
      "suggested_key": {
        "mac": "Alt+Shift+1"
      },
      "description": "幅 375px にする"
    },
    "width-390": {
      "suggested_key": {
        "mac": "Alt+Shift+2"
      },
      "description": "幅 390px にする"
    },
    "width-768": {
      "suggested_key": {
        "mac": "Alt+Shift+3"
      },
      "description": "幅 768px にする"
    },
    "width-1280": {
      "suggested_key": {
        "mac": "Alt+Shift+4"
      },
      "description": "幅 1280px にする"
    }
  }
}
